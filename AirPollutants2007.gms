* Generated by prepare_air_pollutants.py - do not edit by hand.
* Source: REMES-EU_air_pollutant_emissions_EDGAR_fossil_bio_2007_2015_2022.xlsx, sheet 'Source detail', year 2007.
* EDGAR v8.1 air pollutant emissions, Gg/year (= kt/year).
* ---- In plain words ----------------------------------------------------------------------
* This file holds the EDGAR air pollution data used by the model: the list of pollutants,
* the list of pollution sources (power plants, road traffic, homes, farms, waste...) and,
* for each country, how many thousand tonnes of each pollutant each source emitted in 2007.
* A second table gives the part of it that comes from burning wood and other biofuels.
* -------------------------------------------------------------------------------------------

*   pollutants, as GAMS labels (PM2.5 -> PM25)
set pol air pollutants /
    BC
    CO
    NH3
    NMVOC
    NOx
    OC
    PM10
    PM25
    SO2
/;

*   EDGAR source codes (IPCC 2006 categories; 1.A.3.b split into exhaust _noRES and road dust _RES)
set apsrc EDGAR IPCC source codes /
    '1.A.1.a'
    '1.A.1.bc'
    '1.A.2'
    '1.A.3.a'
    '1.A.3.b_RES'
    '1.A.3.b_noRES'
    '1.A.3.c'
    '1.A.3.d'
    '1.A.3.e'
    '1.A.4'
    '1.A.5'
    '1.B.1'
    '1.B.2'
    '2.A.1'
    '2.A.2'
    '2.A.3'
    '2.A.4'
    '2.B'
    '2.C'
    '2.D'
    '2.G'
    '2.H'
    '3.A.2'
    '3.C.1'
    '3.C.2'
    '3.C.4'
    '3.C.7'
    '4.A'
    '4.B'
    '4.C'
    '4.D'
/;

*   fuel combustion sources: split over the fuel purchases of their source group (mapsrcblk)
set apcomb(apsrc) fuel combustion sources /
    '1.A.1.a'
    '1.A.1.bc'
    '1.A.2'
    '1.A.3.a'
    '1.A.3.c'
    '1.A.3.d'
    '1.A.3.e'
    '1.A.4'
    '1.A.5'
/;

*   road exhaust: split over the road fuels (gasoline, diesel) like apcomb
set apmix(apsrc) mixed transport sources (road exhaust) /
    '1.A.3.b_noRES'
/;

*   all other sources: tied to sector output through mapAPs (InputParameters file)
set apact(apsrc) activity-related sources (non-combustion and other combustion) /
    '1.A.3.b_RES'
    '1.B.1'
    '1.B.2'
    '2.A.1'
    '2.A.2'
    '2.A.3'
    '2.A.4'
    '2.B'
    '2.C'
    '2.D'
    '2.G'
    '2.H'
    '3.A.2'
    '3.C.1'
    '3.C.2'
    '3.C.4'
    '3.C.7'
    '4.A'
    '4.B'
    '4.C'
    '4.D'
/;

